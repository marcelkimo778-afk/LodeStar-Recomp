#version 450
// 3x3 vector median of the finest flow (s0): drops lone wrong vectors.
#include "fg_common.glsl"
void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(q, pc.size))) return;
    vec2 v[9];
    int n = 0;
    for (int y = -1; y <= 1; y++)
        for (int x = -1; x <= 1; x++)
            v[n++] = texelFetch(s0, clamp(q + ivec2(x, y), ivec2(0), pc.size - 1), 0).xy;
    int bi = 4;
    float bd = 1e30;
    for (int i = 0; i < 9; i++) {
        float d = 0.0;
        for (int j = 0; j < 9; j++) d += length(v[i] - v[j]);
        if (d < bd) { bd = d; bi = i; }
    }
    imageStore(dst, q, vec4(v[bi], 0.0, 1.0));
}
