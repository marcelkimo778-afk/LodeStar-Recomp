+    g_hwnd = CreateWindowExW(background ? WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE : 0, wc.lpszClassName,
+                             L"LodeStar", WND_STYLE, background ? -32000 : CW_USEDEFAULT,
+                             background ? -32000 : CW_USEDEFAULT, ow, oh, NULL, NULL, inst, NULL);
@@ background window never fullscreen @@
-static void toggle_fullscreen(HWND h) {
-    LONG style = GetWindowLongW(h, GWL_STYLE);
+static void toggle_fullscreen(HWND h) {
+    if (g_background) return;   // [arceus] a test run's window stays off-screen (the saved fullscreen setting too)
+    LONG style = GetWindowLongW(h, GWL_STYLE);
@@ background window past the monitors @@
-                             L"LodeStar", WND_STYLE, background ? -32000 : CW_USEDEFAULT,
-                             background ? -32000 : CW_USEDEFAULT, ow, oh, NULL, NULL, inst, NULL);
