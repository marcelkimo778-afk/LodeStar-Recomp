--- generated/vk/gfx_window_win.c
+++ arceus/vk/gfx_window_win.c
@@ background test window off-screen @@
-    g_hwnd = CreateWindowExW(0, wc.lpszClassName, L"LodeStar", WND_STYLE, CW_USEDEFAULT, CW_USEDEFAULT, ow, oh, NULL,
