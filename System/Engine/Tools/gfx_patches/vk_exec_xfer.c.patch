+
+// [arceus] NPC talk / wild Pokemon sight debugging.
+// SW_OQ_FORCE=1: every samples-passed report gets +1000 (each report larger than the one before: "visible").
+// SW_OQ_LOG=1: per report address, how often it is written, how often nothing passed since the previous
+// report (delta 0) or it had no draws at all, and whether a conditional render reads it (GPU use; an address
+// no condition reads is read back by game code on the CPU).  Printed every 500 reports.
+static int oq_force(void) {
+    static int f = -1;
+    if (f < 0) { const char *e = getenv("SW_OQ_FORCE"); f = e && *e == '1'; }
+    return f;
+}
+int vk_exec_oq_log_on(void);
+static int oq_log_on(void) { return vk_exec_oq_log_on(); }
+int vk_exec_oq_log_on(void) {
+    static int f = -1;
+    if (f < 0) { const char *e = getenv("SW_OQ_LOG"); f = e && *e == '1'; }
+    return f;
+}
+#define OQ_ST 2048
+static struct { uint64_t addr, last; uint32_t n, zero, nodraw, cond; } oq_st[OQ_ST];
+static uint64_t oq_st_reports, oq_st_resets, oq_st_noaddr;
+
+static uint32_t oq_st_slot(uint64_t addr) {
+    uint32_t h = (uint32_t)((addr >> 3) * 2654435761u) % OQ_ST;
+    for (uint32_t k = 0; k < OQ_ST; k++, h = (h + 1) % OQ_ST)
+        if (oq_st[h].addr == addr || !oq_st[h].addr) { oq_st[h].addr = addr; return h; }
+    return UINT32_MAX;
+}
+
+static void oq_mark_cond(uint64_t addr) {
+    if (!oq_log_on()) return;
+    uint32_t h = oq_st_slot(addr);
+    if (h != UINT32_MAX) oq_st[h].cond++;
+}
+
+static void oq_stat(const OqSegment *s, uint64_t sum) {
+    if (!oq_log_on()) return;
+    if (s->reset) { oq_st_resets++; return; }
+    oq_st_reports++;
+    if (!s->addr) oq_st_noaddr++;
+    else {
+        uint32_t h = oq_st_slot(s->addr);
+        if (h != UINT32_MAX) {
+            oq_st[h].n++, oq_st[h].last = oq_count;
+            if (!sum) oq_st[h].zero++;
+            if (!s->n) oq_st[h].nodraw++;
+        }
+    }
+    if (oq_st_reports % 500 && oq_st_reports != 1 && oq_st_reports != 10 && oq_st_reports != 50 && oq_st_reports != 100 && oq_st_reports != 250) return;
+    uint32_t used = 0, cpu = 0, cpu_zero = 0;
+    for (uint32_t i = 0; i < OQ_ST; i++) if (oq_st[i].n) {
+        used++;
+        if (!oq_st[i].cond) { cpu++; if (oq_st[i].zero == oq_st[i].n) cpu_zero++; }
+    }
+    rt_log("[oq] %llu reports, %llu resets, %llu to GPU-only memory; %u addresses, %u never used by a render "
+           "condition (CPU-read), %u of those always delta 0",
+           (unsigned long long)oq_st_reports, (unsigned long long)oq_st_resets, (unsigned long long)oq_st_noaddr,
+           used, cpu, cpu_zero);
+    uint32_t shown = 0;
+    for (uint32_t i = 0; i < OQ_ST && shown < 40; i++) if (oq_st[i].n && !oq_st[i].cond) {
+        rt_log("[oq]   cpu addr %#llx: %u reports, %u delta 0, %u without draws, last %llu",
+               (unsigned long long)oq_st[i].addr, oq_st[i].n, oq_st[i].zero, oq_st[i].nodraw,
+               (unsigned long long)oq_st[i].last);
+        shown++;
+    }
+    if (oq_st_reports % 500 == 0) for (uint32_t i = 0; i < OQ_ST; i++) oq_st[i].n = oq_st[i].zero = oq_st[i].nodraw = 0;
 }
 
